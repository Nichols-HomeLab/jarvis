# Local-first Jarvis runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# OpenAI-compatible model endpoint
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=dummy
OPENAI_ROUTER_MODEL=gemma3n:e4b
OPENAI_VISION_MODEL=qwen2.5vl:7b
OPENAI_RESEARCH_MODEL=qwen2.5:7b
ALLOW_MOCK_VISION=true

# Local storage
DATABASE_URL=sqlite:///data/jarvis_local.db
MEDIA_ROOT=data/media
DEFAULT_ACTOR_NAME=David

# Frontend proxy target when running via Docker Compose
VITE_BACKEND_PROXY=http://backend:8000

# Cameras
# Provide one or more RTSP or snapshot-capable cameras. Reolink motion/person
# events can be layered on later, but the MVP uses snapshot URLs now.
JARVIS_CAMERAS_JSON=[{"name":"pegboard","snapshot_url":"http://reolink.local/cgi-bin/api.cgi?cmd=Snap&channel=0&rs=jarvis&user=admin&password=password","zone_name":"upper_left_pegboard"},{"name":"workbench","snapshot_url":"http://reolink.local/cgi-bin/api.cgi?cmd=Snap&channel=1&rs=jarvis&user=admin&password=password","zone_name":"main_workbench"}]

# Legacy repo variables below are kept only if you still run the original server.py.
ANTHROPIC_API_KEY=
FISH_API_KEY=
FISH_VOICE_ID=
USER_NAME=David
