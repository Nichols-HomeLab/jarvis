APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JARVIS_ACCESS_TOKEN=replace-with-unique-random-value-at-least-32-characters
DATABASE_URL=sqlite:///data/jarvis_local.db
MEDIA_ROOT=data/media
DEFAULT_ACTOR_NAME=David
VITE_BACKEND_PROXY=http://backend:8000

# Local OpenAI-compatible model server. From Docker, host.docker.internal reaches the host.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=dummy
OPENAI_ROUTER_MODEL=gemma3:4b
OPENAI_RESEARCH_MODEL=qwen2.5:7b
OPENAI_VISION_MODEL=qwen2.5vl:7b
ALLOW_MOCK_VISION=false

# Local OpenAI-compatible speech endpoints.
STT_BASE_URL=http://host.docker.internal:8081/v1
STT_MODEL=whisper-1
TTS_BASE_URL=http://host.docker.internal:8082/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Frigate: use an internal trusted URL or an authenticated 8971 endpoint.
FRIGATE_URL=http://host.docker.internal:5000
FRIGATE_TOKEN=
FRIGATE_USER=
FRIGATE_PASSWORD=
JARVIS_CAMERAS_JSON=[{"name":"pegboard","frigate_name":"pegboard","zone_name":"pegboard"},{"name":"workbench","frigate_name":"workbench","zone_name":"workbench"}]
MOTION_WEBHOOK_TOKEN=replace-with-long-random-value
SATELLITE_TOKEN=replace-with-separate-long-random-value
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=frigate

# Local SearXNG server configured with JSON response format.
SEARXNG_URL=http://searxng:8080

# Home Assistant writes are restricted to these exact entity IDs.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_ALLOWED_ENTITIES=light.outbuilding,scene.work_mode

# Measured physical size of the fullscreen projected browser viewport.
PROJECTOR_WIDTH_MM=0
PROJECTOR_HEIGHT_MM=0
